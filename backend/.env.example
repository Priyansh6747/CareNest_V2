# =============================================================================
# CareNest Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# LLM Provider (required)
# -----------------------------------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model overrides (optional - these are the defaults)
# NOTE: available models depend on your Groq account. Check with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
# low | medium | high - reasoning models only
GROQ_REASONING_EFFORT=medium

# -----------------------------------------------------------------------------
# Firebase Configuration (required)
# -----------------------------------------------------------------------------
# Path to your Firebase service account JSON file (relative to backend/)
FIREBASE_CREDENTIALS=./care-45426-firebase-adminsdk-fbsvc-3c8cacde10.json

# -----------------------------------------------------------------------------
# Nearby places - hospitals & food outlets (optional)
# -----------------------------------------------------------------------------
# Without this the /nearby-hospitals and /food/nearby-outlets endpoints
# return 400 "API key not configured". Free tier at https://myprojects.geoapify.com
GEOAPIFY_API_KEY=

# -----------------------------------------------------------------------------
# Nutrition data - USDA FoodData Central (optional)
# -----------------------------------------------------------------------------
# Used by MacroBreakdown to look up per-ingredient nutrients.
# Without it meal analysis falls back to AI-estimated values.
# Free key at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
