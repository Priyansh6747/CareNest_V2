# =============================================================================
# CareNest Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# Firebase Configuration
# -----------------------------------------------------------------------------
# Path to your Firebase service account JSON file (relative to backend/)
FIREBASE_CREDENTIALS=./firebase-service-account.json

# (Alternative) Inline Firebase credentials as JSON string
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Set to your IPv4 address (find with: ip addr | grep inet or ipconfig)
HOST=0.0.0.0
PORT=8000


